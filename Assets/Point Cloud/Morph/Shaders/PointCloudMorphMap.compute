#pragma kernel CSMain

Texture2D<float4> _SourcePositionMap;
Texture2D<float4> _SourceColorMap;
Texture2D<float4> _TargetPositionMap;
Texture2D<float4> _TargetColorMap;
RWTexture2D<float4> _OutputPositionMap;
RWTexture2D<float4> _OutputColorMap;

float4x4 _SourceTransform;
float4x4 _TargetTransform;

int _SourceSize;
int _TargetSize;
int _OutputSize;
int _SourcePointCount;
int _TargetPointCount;
int _OutputPointCount;

float _Progress;
float _EasedProgress;
float _Time;
float _DanceRadius;
float _VerticalWave;
float _SwirlTurns;
float _DanceSpeed;
float _ParticleStagger;
float _ColorShimmer;
float _BreathAmount;
float _FloatAmount;
float _BreathSpeed;
float _IdleStrength;

static const float PI = 3.14159265;
static const float TAU = 6.28318531;

uint Hash(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

float Hash01(uint value)
{
    return (Hash(value) & 0x00ffffffu) / 16777215.0;
}

uint MapIndex(uint outputIndex, uint pointCount)
{
    if (outputIndex < pointCount)
    {
        return outputIndex;
    }

    return Hash(outputIndex * 132049u + pointCount * 9176u) % pointCount;
}

uint2 IndexToCoord(uint index, uint size)
{
    return uint2(index % size, index / size);
}

float Smooth01(float value)
{
    float t = saturate(value);
    return t * t * (3.0 - 2.0 * t);
}

float3 RotateY(float3 value, float angle)
{
    float s;
    float c;
    sincos(angle, s, c);
    return float3(value.x * c - value.z * s, value.y, value.x * s + value.z * c);
}

float3 ApplyAlignment(float3 position, float4x4 transform)
{
    return mul(transform, float4(position, 1.0)).xyz;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_OutputSize || id.y >= (uint)_OutputSize)
    {
        return;
    }

    uint outputIndex = id.y * (uint)_OutputSize + id.x;
    if (outputIndex >= (uint)_OutputPointCount)
    {
        _OutputPositionMap[id.xy] = 0.0;
        _OutputColorMap[id.xy] = 0.0;
        return;
    }

    uint sourcePointCount = (uint)max(1, _SourcePointCount);
    uint targetPointCount = (uint)max(1, _TargetPointCount);
    uint sourceIndex = MapIndex(outputIndex, sourcePointCount);
    uint targetIndex = MapIndex(outputIndex, targetPointCount);

    uint2 sourceCoord = IndexToCoord(sourceIndex, (uint)_SourceSize);
    uint2 targetCoord = IndexToCoord(targetIndex, (uint)_TargetSize);

    float4 sourcePosition = _SourcePositionMap.Load(int3((int)sourceCoord.x, (int)sourceCoord.y, 0));
    float4 targetPosition = _TargetPositionMap.Load(int3((int)targetCoord.x, (int)targetCoord.y, 0));
    float4 sourceColor = _SourceColorMap.Load(int3((int)sourceCoord.x, (int)sourceCoord.y, 0));
    float4 targetColor = _TargetColorMap.Load(int3((int)targetCoord.x, (int)targetCoord.y, 0));
    sourcePosition.xyz = ApplyAlignment(sourcePosition.xyz, _SourceTransform);
    targetPosition.xyz = ApplyAlignment(targetPosition.xyz, _TargetTransform);

    float randomA = Hash01(outputIndex * 17u + 3u);
    float randomB = Hash01(outputIndex * 97u + 23u);
    float randomC = Hash01(outputIndex * 193u + 71u);

    float delay = randomA * _ParticleStagger;
    float localProgress = saturate((_Progress - delay) / max(0.001, 1.0 - delay * 0.85));
    float morphProgress = Smooth01(localProgress);
    float colorProgress = Smooth01(saturate((_Progress - delay * 0.55) / max(0.001, 1.0 - delay * 0.45)));

    float3 basePosition = lerp(sourcePosition.xyz, targetPosition.xyz, morphProgress);
    float transitionEnergy = max(sin(saturate(_Progress) * PI), sin(localProgress * PI)) * (1.0 - _IdleStrength);

    float radius = max(length(basePosition), 0.001);
    float3 radialDirection = basePosition / radius;
    float phase = _Time * _DanceSpeed * (0.65 + randomA * 1.35) + randomB * TAU + radius * 0.23;

    float swirlAngle = (_SwirlTurns * TAU * (1.0 - morphProgress * 0.25) + sin(phase) * 0.35) * transitionEnergy;
    float3 swirl = RotateY(basePosition, swirlAngle) - basePosition;
    float3 wave = float3(
        sin(phase + basePosition.y * 2.1),
        cos(phase * 1.31 + basePosition.x * 1.7),
        sin(phase * 0.73 + basePosition.z * 2.4));
    float3 dance = normalize(wave) * _DanceRadius * transitionEnergy * (0.55 + randomC * 0.75);
    float3 lift = float3(0.0, sin(phase * 0.9) * _VerticalWave * transitionEnergy, 0.0);

    float idlePhase = _Time * _BreathSpeed + radius * 1.7 + randomB * TAU;
    float3 idleMotion =
        radialDirection * (sin(idlePhase) * _BreathAmount * _IdleStrength) +
        float3(0.0, sin(idlePhase * 0.71 + basePosition.x * 0.2) * _FloatAmount * _IdleStrength, 0.0) +
        wave * (_FloatAmount * 0.25 * _IdleStrength);

    float4 outputPosition = float4(basePosition + swirl + dance + lift + idleMotion, 1.0);
    float4 outputColor = lerp(sourceColor, targetColor, colorProgress);

    float shimmer = (sin(phase * 1.9) + sin(phase * 2.7 + randomC * TAU)) * 0.5;
    float3 tint = lerp(float3(0.62, 0.9, 1.0), float3(1.0, 0.68, 0.48), randomB);
    outputColor.rgb = saturate(outputColor.rgb + tint * shimmer * _ColorShimmer * transitionEnergy);
    outputColor.a = max(outputColor.a, 1.0);

    _OutputPositionMap[id.xy] = outputPosition;
    _OutputColorMap[id.xy] = outputColor;
}
